# ─────────────────────────────────────────────────────────────
# Configurare SELECT BOT
# Copiază acest fișier în „.env" și completează valorile reale.
# ─────────────────────────────────────────────────────────────

# OBLIGATORIU — Token-ul botului, obținut de la @BotFather pe Telegram.
# Scrie /newbot la @BotFather, alege un nume, și lipește token-ul aici.
TELEGRAM_BOT_TOKEN=

# OPȚIONAL — Cheia Claude API pentru asistentul inteligent și marketing.
# Fără ea, botul funcționează în continuare (comenzi + meniuri),
# dar fără răspunsuri AI. O obții de la https://console.anthropic.com
ANTHROPIC_API_KEY=

# OPȚIONAL — ID-urile de Telegram ale persoanelor cu drept de acces (separate prin virgulă).
# Dacă e gol, oricine poate folosi botul. Află-ți ID-ul scriind /start botului
# (apare în consolă) sau folosește @userinfobot.
# Exemplu: ADMIN_IDS=123456789,987654321
ADMIN_IDS=
